@model StaffCheckViewModel
@{
    ViewData["Title"] = "Gate Staff Home";
}

<div class="container mt-4">
  <h2>Gate Staff - Ticket Check</h2>
  <p class="text-muted">Type the ticket code to check entry. A valid ticket is marked as used.</p>

  <div class="row">
    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5>Verify Ticket</h5>
          <form asp-action="Index" method="post">
            <div class="mb-3">
              <label asp-for="TicketCode" class="form-label"></label>
              <input asp-for="TicketCode" class="form-control" placeholder="e.g. 3F9A1C2B" />
            </div>
            <button type="submit" class="btn btn-primary">Verify</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      @if (!string.IsNullOrEmpty(Model.Message))
      {
        <h5>Result</h5>
        <div class="alert @Model.AlertClass">@Model.Message</div>
      }
    </div>
  </div>
</div>

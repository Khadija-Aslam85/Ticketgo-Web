@model Event
@{
    ViewData["Title"] = "Book Seats";
}

@section Styles {
  <link href="~/css/book.css" rel="stylesheet" />
}

<div class="container mt-4">
  <h2>@Model.Title</h2>
  <p class="text-muted">@Model.Venue | @Model.Date.ToString("dd MMM yyyy") | Rs. @Model.Price.ToString("N0") per seat</p>

  @Html.AntiForgeryToken()

  <h5 class="mt-4">Choose your seats</h5>
  <p>
    <span class="badge bg-success">Free</span>
    <span class="badge bg-primary">Selected</span>
    <span class="badge bg-secondary">Taken</span>
  </p>

  <div id="seatBox" class="seat-grid mb-3"
       data-event-id="@Model.Id"
       data-seats-url="@Url.Action("Seats", "Attendee", new { id = Model.Id })"
       data-book-url="@Url.Action("BookSeats", "Attendee")"
       data-price="@Model.Price.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">
    <span class="text-muted">Loading seats...</span>
  </div>

  <p id="summary" class="fw-bold">No seats selected.</p>

  <button type="button" id="confirmBtn" class="btn btn-primary">Confirm Booking</button>
  <a asp-action="Index" class="btn btn-outline-secondary">My Tickets</a>

  <div id="msg" class="mt-3"></div>
</div>

@section Scripts {
  <script src="~/js/book.js"></script>
}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] | TicketGo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
      <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">TicketGo</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="menu">
        <ul class="navbar-nav me-auto">
          <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
          @if (User.Identity?.IsAuthenticated == true)
          {
            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
          }
        </ul>
        @if (User.Identity?.IsAuthenticated == true)
        {
          <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-light">Logout</button>
          </form>
        }
        else
        {
          <a class="btn btn-outline-light me-2" asp-controller="Account" asp-action="Login">Login</a>
          <a class="btn btn-light" asp-controller="Account" asp-action="Register">Sign Up</a>
        }
      </div>
    </div>
  </nav>

  <main>
    <div class="container mt-3">
      @if (TempData["Success"] != null)
      {
        <div class="alert alert-success">@TempData["Success"]</div>
      }
      @if (TempData["Error"] != null)
      {
        <div class="alert alert-danger">@TempData["Error"]</div>
      }
    </div>

    @RenderBody()
  </main>

  <footer class="bg-dark text-white text-center py-3 mt-5">
    <small>&copy; 2026 TicketGo | Khadija Aslam | BSEF24A043</small>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

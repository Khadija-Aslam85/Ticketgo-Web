@model List<Event>
@{
    ViewData["Title"] = "Organizer Home";
    var seatsBooked = Model.Sum(e => e.Tickets.Count);
    var totalSales = Model.Sum(e => e.Tickets.Count * e.Price);
}

<div class="container mt-4">
  <h2>Organizer Dashboard</h2>

  <div class="row g-3 mt-2">
    <div class="col-md-4"><div class="card text-center"><div class="card-body"><h6>My Events</h6><h2>@Model.Count</h2></div></div></div>
    <div class="col-md-4"><div class="card text-center"><div class="card-body"><h6>Seats Booked</h6><h2>@seatsBooked</h2></div></div></div>
    <div class="col-md-4"><div class="card text-center"><div class="card-body"><h6>Total Sales</h6><h2>Rs. @totalSales.ToString("N0")</h2></div></div></div>
  </div>

  <div class="d-flex justify-content-between align-items-center mt-5 mb-3">
    <h4 class="mb-0">My Events</h4>
    <a asp-action="Create" class="btn btn-primary">+ Create Event</a>
  </div>

  @if (Model.Count == 0)
  {
    <p class="text-muted">You have not created any events yet.</p>
  }
  else
  {
    <div class="table-responsive">
      <table class="table table-bordered align-middle">
        <thead class="table-light">
          <tr><th>Event</th><th>Date</th><th>Seats Booked</th><th>Action</th></tr>
        </thead>
        <tbody>
          @foreach (var e in Model)
          {
            <tr>
              <td>@e.Title</td>
              <td>@e.Date.ToString("dd MMM yyyy")</td>
              <td>@e.Tickets.Count / @e.TotalSeats</td>
              <td>
                <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-warning me-1">Edit</a>
                <form asp-action="Delete" asp-route-id="@e.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this event?');">
                  <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>

@model OrganizerDashboardViewModel
@{
    ViewData["Title"] = "Organizer Home";
}

<div class="container mt-4">
  <h2>Organizer Dashboard</h2>
  @Html.AntiForgeryToken()

  <div class="row g-3 mt-2">
    <div class="col-md-4"><div class="card text-center"><div class="card-body"><h6>My Events</h6><h2>@Model.Stats.Events</h2></div></div></div>
    <div class="col-md-4"><div class="card text-center"><div class="card-body"><h6>Seats Booked</h6><h2>@Model.Stats.SeatsBooked</h2></div></div></div>
    <div class="col-md-4"><div class="card text-center"><div class="card-body"><h6>Total Sales</h6><h2>Rs. @Model.Stats.TotalSales.ToString("N0")</h2></div></div></div>
  </div>

  <div class="d-flex justify-content-between align-items-center mt-5 mb-3">
    <h4 class="mb-0">My Events</h4>
    <a asp-action="Create" class="btn btn-primary">+ Create Event</a>
  </div>

  @if (Model.Events.Count == 0)
  {
    <p class="text-muted">You have not created any events yet.</p>
  }
  else
  {
    <div class="table-responsive">
      <table class="table table-bordered align-middle">
        <thead class="table-light">
          <tr><th>Event</th><th>Date</th><th>Seats Booked</th><th>Action</th></tr>
        </thead>
        <tbody>
          @foreach (var e in Model.Events)
          {
            <tr>
              <td>@e.Title</td>
              <td>@e.Date.ToString("dd MMM yyyy")</td>
              <td>@e.SeatsBooked / @e.TotalSeats</td>
              <td>
                <a asp-action="Edit" asp-route-id="@e.Id" class="btn btn-sm btn-warning me-1">Edit</a>
                <button type="button" class="btn btn-sm btn-danger js-delete"
                        data-url="@Url.Action("Delete", "Organizer", new { id = e.Id })">Delete</button>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>
